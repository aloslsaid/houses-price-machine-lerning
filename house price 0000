import numpy as np

import pandas as pd

from sklearn.datasets import fetch_california_housing

from sklearn.model_selection import train_test_split

from sklearn.preprocessing import StandardScaler
from sklearn.base import clone

from sklearn.linear_model import LinearRegression, Ridge

from sklearn.tree import DecisionTreeRegressor

from sklearn.ensemble import RandomForestRegressor, GradientBoostingRegressor

from sklearn.neighbors import KNeighborsRegressor

from sklearn.metrics import r2_score, mean_absolute_error, mean_squared_error

data = fetch_california_housing(as_frame=True)

df = data.frame

X = df.drop("MedHouseVal", axis=1)

y = df["MedHouseVal"]

# Split before fitting any preprocessing: validation selects the model,
# while the test split is reserved for one final unbiased report.
X_train_full, X_test, y_train_full, y_test = train_test_split(
    X, y, test_size=0.15, random_state=42
)
X_train, X_validation, y_train, y_validation = train_test_split(
    X_train_full, y_train_full, test_size=0.1765, random_state=43
)

scaled_model_names = {"Linear Regression", "Ridge", "KNN"}
train_scaler = StandardScaler()
X_train_scaled = train_scaler.fit_transform(X_train)
X_validation_scaled = train_scaler.transform(X_validation)
X_test_scaled = train_scaler.transform(X_test)

models = {
    "Linear Regression": LinearRegression(),
    "Ridge": Ridge(alpha=1.0),
    "Decision Tree": DecisionTreeRegressor(random_state=42, max_depth=15),
    "Random Forest": RandomForestRegressor(
        n_estimators=300, random_state=42, n_jobs=-1
    ),
    "Gradient Boosting": GradientBoostingRegressor(
        n_estimators=300, learning_rate=0.05, max_depth=3, random_state=42
    ),
    "KNN": KNeighborsRegressor(n_neighbors=5),
}

validation_results = []
validation_models = {}
for name, estimator in models.items():
    model = clone(estimator)
    if name in scaled_model_names:
        train_data = X_train_scaled
        validation_data = X_validation_scaled
    else:
        train_data = X_train
        validation_data = X_validation

    model.fit(train_data, y_train)
    predictions = model.predict(validation_data)
    validation_results.append([
        name,
        r2_score(y_validation, predictions),
        mean_absolute_error(y_validation, predictions),
        np.sqrt(mean_squared_error(y_validation, predictions)),
    ])
    validation_models[name] = model

results_df = pd.DataFrame(
    validation_results, columns=["Model", "Validation R2", "Validation MAE", "Validation RMSE"]
).sort_values("Validation R2", ascending=False).reset_index(drop=True)

print("\\nMODEL COMPARISON (VALIDATION)")
print(results_df.to_string(index=False))

best_model_name = results_df.iloc[0]["Model"]
selected_model = validation_models[best_model_name]
if best_model_name in scaled_model_names:
    test_data = X_test_scaled
else:
    test_data = X_test
test_predictions = selected_model.predict(test_data)

print("\\nSELECTED MODEL:", best_model_name)
print("HELD-OUT TEST R2:", r2_score(y_test, test_predictions))
print("HELD-OUT TEST MAE:", mean_absolute_error(y_test, test_predictions))
print("HELD-OUT TEST RMSE:", np.sqrt(mean_squared_error(y_test, test_predictions)))

# Refit the selected model on all development data after final test evaluation.
if best_model_name in scaled_model_names:
    scaler = StandardScaler()
    development_data = scaler.fit_transform(X_train_full)
else:
    scaler = None
    development_data = X_train_full

best_model = clone(models[best_model_name])
best_model.fit(development_data, y_train_full)

print("\nBest Model:", best_model_name)

if best_model_name in [

    "Decision Tree",

    "Random Forest",

    "Gradient Boosting"

]:

    importance = pd.DataFrame({

        "Feature": X.columns,

        "Importance": best_model.feature_importances_

    })

    importance = importance.sort_values(

        by="Importance",

        ascending=False

    )

    print("\nFeature Importance:")

    print(importance.to_string(index=False))

example = X_test.iloc[[0]]

actual = y_test.iloc[0]

if best_model_name in scaled_model_names:
    example_prediction = best_model.predict(scaler.transform(example))[0]
else:
    example_prediction = best_model.predict(example)[0]

print("\nPredicted Price:", example_prediction * 100000)